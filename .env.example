# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API -> Legacy anon, service_role API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (same page, "service_role" -> Reveal)
# SERVER-SIDE ONLY. Never expose this to the client or commit it. Used for admin-only
# operations (e.g. creating doctor login accounts).
SUPABASE_SERVICE_ROLE_KEY=
